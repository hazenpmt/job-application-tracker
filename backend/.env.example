PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://127.0.0.1:5173

# PostgreSQL: copy this file to .env, then fill PGPASSWORD locally.
# Keeping the password in its own variable avoids URL-encoding problems with special characters.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-postgres-password
PGDATABASE=job_application_tracker

# Optional alternative: a single connection string instead of the PG* variables above.
# DATABASE_URL=postgres://postgres:your-password@localhost:5432/job_application_tracker
